<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>卒業研究プログラム</title>
<style>
  body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    background-color: white; /* 背景色を白に */
    color: black; /* 文字色を黒に */
  }
  .question{
    display: none;
    background-color: inherit; /* 背景色を親要素に合わせる */
    color: inherit; /* 文字色を親要素に合わせる */
    padding: 20px;
    font-size: 100px; /* 個別要素の文字を大きく */
    text-align: center; /* テキストを中央に */
  }
  .start-menu {
    display: none;
    flex-direction: column;
    background-color: inherit; /* 背景色を親要素に合わせる */
    padding: 20px;
    text-align: center; /* テキストを中央に */
  }
  .visible {
    display: block;
  }
  #countdown {
    font-size: 0.00001px; /* カウントダウンの文字を大きく */
    color: inherit;
  }
  button {
    font-size: 50px; /* ボタンの文字を大きく */
    margin: 10px;
  }
  .large-input {
    font-size: 80px; /* テキストボックスの文字を大きく */
    width: 300px; /* テキストボックスの幅を大きく */
    height: 100px; /* テキストボックスの高さを大きく */
  }
  .custom-input {
    background-color: inherit; /* テキストボックスの背景色 */
    color: inherit; /* テキストの色 */
  }
  #white-black{
    background-color: white;
    color: black;
    border: 2px solid black
  }
  #black-white{
    background-color: black;
    color: white;
    border: 2px solid white
  }
  #white-green{
    background-color: white;
    color: green;
    border: 2px solid green
  }
  #black-green{
    background-color: black;
    color: green;
    border: 2px solid green
  }
  .frac_bar {
    padding: 0;
    border-bottom-width: 4px;
    border-bottom-style: solid;
    border-bottom-color: inherit;
  }
</style>
</head>
<body>

<div id="start-menu" class="start-menu visible">
  <button id="white-black" class="color-select-button" onclick="changeTheme('white', 'black')">白背景黒文字</button><br>
  <button id="black-white" class="color-select-button" onclick="changeTheme('black', 'white')">黒背景白文字</button><br>
  <button id="white-green" class="color-select-button" onclick="changeTheme('white', 'green')">白背景緑文字</button><br>
