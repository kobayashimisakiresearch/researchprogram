  function startCountdown() {
    let countdown = 20;
    document.getElementById('question-container').innerHTML = `<p id="countdown">${countdown}</p>`;
    document.getElementById('question-container').classList.add('visible');

    const countdownInterval = setInterval(() => {
      countdown -= 1;
      document.getElementById('countdown').textContent = countdown;

      if (countdown === 0) {
        clearInterval(countdownInterval);
        showNextQuestion();
        intervalId = setInterval(showNextQuestion, question_interval);
      }
    }, 1000);
  }

  function showNextQuestion() {
    let answerElement = document.getElementById('answer');
    if (answerElement) {
      answers.push(answerElement.value);
    }
    const q_num = q_index[currentIndex];
    document.getElementById('question-container').innerHTML = `<p id="question-text">${questions[q_num]}</p>`;
    answerElement = document.getElementById('answer')
    if( answerElement ){
      answerElement.focus()
      startTime = new Date(); // 解答開始時刻
      answerTimes[currentIndex] = null;
    }

    currentIndex++;

    if (currentIndex > questions.length) {
      saveAnswersToFile();
      clearInterval(intervalId);
      endProgram();
    }

  }

  function checkAnswer(userAnswer, correctAnswer) {
  return parseInt(userAnswer) === correctAnswer ? 'TRUE' : 'FALSE';
}


function saveAnswersToFile() {
  const timeText = nowText();
  const filename = timeText + "-" + globalBackgroundColor + "-" + globalTextColor + "-answers.csv";

  // 配色に応じて正しい正解リストを選択する
  let correctAnswers;
  if (globalBackgroundColor === 'white' && globalTextColor === 'black') {
    correctAnswers = answers_key_wb;
  } else if (globalBackgroundColor === 'black' && globalTextColor === 'white') {
    correctAnswers = answers_key_bw;
  } else if (globalBackgroundColor === 'white' && globalTextColor === 'green') {
    correctAnswers = answers_key_wg;
  } else if (globalBackgroundColor === 'black' && globalTextColor === 'green') {
    correctAnswers = answers_key_bg;
  }

  let csvContent = "data:text/csv;charset=utf-8," + "No,Question,Answer,Correct Answer,Result,Time[s],Background Color,Text Color\n";

  csvContent += answers.map((answer, index) => {
    const correctAnswer = correctAnswers[index];  // 配色に応じた正解リストを使用
    const result = checkAnswer(answer, correctAnswer);
    return `${index+1},${q_index[index] + 1},${answer},${correctAnswer},${result},${answerTimes[index]},${globalBackgroundColor},${globalTextColor}`;
  }).join("\n");

  const encodedUri = encodeURI(csvContent);
  const link = document.createElement("a");
  link.setAttribute("href", encodedUri);
  const downloadLink = document.createElement("a");
  downloadLink.setAttribute("href", encodedUri);
  downloadLink.setAttribute("download", filename);
  document.body.appendChild(downloadLink);
  downloadLink.click();
  document.body.removeChild(downloadLink);
}

function endProgram() {
    clearInterval(intervalId);
    document.getElementById('question-container').classList.remove('visible');
    document.getElementById('start-menu').classList.add('visible');
    currentIndex = 0;
    answers.length = 0; // reset answers
    answerTimes.length = 0; // reset answerTimes as well
}


  
  function answerChange(){
    const delay_sec = (new Date() - startTime)/1000;
    answerTimes[currentIndex-1] = delay_sec;
  }

  function changeTheme(backgroundColor, textColor) {
    document.body.style.backgroundColor = backgroundColor;
    document.body.style.color = textColor;

    const inputs = document.querySelectorAll('.large-input');
    inputs.forEach(input => {
      input.style.backgroundColor = backgroundColor;
      input.style.color = textColor === textColor;
    });

    const buttons = document.querySelectorAll(".color-select-button")
    buttons.forEach( b => {
      b.style.borderColor = b.style.color;
    });

    const clickedButton = document.getElementById( backgroundColor + "-" + textColor)
    clickedButton.style.borderColor = 'red';

    if( backgroundColor == 'white' && textColor == 'black')
      questions = questions_wb;
    else if( backgroundColor == 'black' && textColor == 'white' )
      questions = questions_bw;
    else if( backgroundColor == 'white' && textColor == 'green' )
      questions = questions_wg;
    else if( backgroundColor == 'black' && textColor == 'green' )
      questions = questions_bg;

    let q_index = Array.from(Array(questions.length).keys()); // [0, 1, ...]
    if( shuffle )
      arrayShuffle(q_index);


    globalBackgroundColor = backgroundColor;
    globalTextColor = textColor;
  }

  function arrayShuffle( array ){
    newArray = [];

    while (array.length > 0) {
      n = array.length;
      k = Math.floor(Math.random() * n);

      newArray.push(array[k]);
      array.splice(k, 1);
    }
    array.push(...newArray);
  }

  function nowText(){
    now = new Date();
    Y = now.getFullYear().toString();
    M = (now.getMonth() + 1).toString().padStart(2,"0");
    D = now.getDate().toString().padStart(2,"0");
    h = now.getHours().toString().padStart(2,"0");
    m = now.getMinutes().toString().padStart(2,"0");
    s = now.getSeconds().toString().padStart(2,"0");
    return Y+M+D+"-"+h+m+s;

  }
</script>

